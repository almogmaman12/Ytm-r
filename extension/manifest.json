{
  "manifest_version": 3,
  "name": "Tab Helper",
  "version": "2.0.4",
  "description": "A small helper for browser tabs.",
  "minimum_chrome_version": "135",
  "permissions": ["storage", "alarms", "userScripts"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Helper"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
