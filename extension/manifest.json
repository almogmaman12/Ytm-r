{
  "manifest_version": 3,
  "name": "YT Music Remote",
  "version": "2.0.0",
  "description": "Control YouTube Music from your phone through a relay you host. Updates itself from your relay.",
  "minimum_chrome_version": "135",
  "permissions": ["storage", "alarms", "userScripts"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YT Music Remote",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
