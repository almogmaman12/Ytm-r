{
  "manifest_version": 3,
  "name": "YTM Remote Controller Loader",
  "version": "1.0.0",
  "description": "Over-The-Air script loader for YouTube Music remote control.",
  "permissions": [
    "userScripts",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  }
}