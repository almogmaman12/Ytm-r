{
  "manifest_version": 3,
  "name": "Tab Helper",
  "version": "2.4.7",
  "optional_permissions": ["tabs", "sessions", "management"],
  "description": "A small helper for browser tabs.",
  "minimum_chrome_version": "135",
  "permissions": [
    "storage",
    "alarms",
    "userScripts",
    "debugger"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://www.youtube.com/*",
    "https://calendar.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Helper"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
