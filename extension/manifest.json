{
  "manifest_version": 3,
  "name": "YT Music Remote",
  "version": "1.3.0",
  "description": "Lets you control YouTube Music playback from your phone through a relay server you run.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "YT Music Remote",
    "default_popup": "options.html"
  }
}
