<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YtmCompanion</AssemblyName>
    <RootNamespace>YtmCompanion</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(ExtensionPublicKeyPath)' != ''">
    <EmbeddedResource Include="$(ExtensionPublicKeyPath)" LogicalName="YtmCompanion.ReleasePublicKey.pem" />
  </ItemGroup>
  <Target Name="RequireReleaseKey" BeforeTargets="PrepareForBuild" Condition="'$(RequirePublisherKey)' == 'true'">
    <Error Condition="'$(ExtensionPublicKeyPath)' == '' Or !Exists('$(ExtensionPublicKeyPath)')" Text="Production builds require a trusted public verification key." />
  </Target>
</Project>
