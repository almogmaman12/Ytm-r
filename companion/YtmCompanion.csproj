<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YtmCompanion</AssemblyName>
    <RootNamespace>YtmCompanion</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <InternalsVisibleTo Include="YtmCompanion.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExtensionPublicKeyPath)' != ''">
    <EmbeddedResource Include="$(ExtensionPublicKeyPath)" LogicalName="YtmCompanion.ReleasePublicKey.pem" />
  </ItemGroup>
  <Target Name="RequireReleaseKey" BeforeTargets="PrepareForBuild" Condition="'$(RequirePublisherKey)' == 'true'">
    <Error Condition="'$(ExtensionPublicKeyPath)' == '' Or !Exists('$(ExtensionPublicKeyPath)')" Text="Production builds require a trusted public verification key." />
  </Target>
</Project>
